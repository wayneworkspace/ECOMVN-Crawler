# Copy to .env (or set in the shell). All optional.
# Project home: where configs/, data/, output/ and browser profiles live (default: current directory)
ECOMMERCE_HOME=
# Use a specific configs/ folder instead of <home>/configs
ECOMMERCE_CONFIG_DIR=
# Browser binary override (tests, non-standard install locations)
ECOMMERCE_CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# attach (default) | launch
ECOMMERCE_BROWSER_MODE=attach
